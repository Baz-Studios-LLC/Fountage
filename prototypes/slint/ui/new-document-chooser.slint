import { ComboBox, ScrollView } from "std-widgets.slint";
// Match the Swift chooser’s restrained controls and typography. Helvetica Neue
// is available on macOS; Slint falls back to the platform font elsewhere.
component ChooserButton inherits Rectangle {
    in property <string> text;
    in property <bool> dark;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    min-width: label.preferred-width + 28px;
    height: 26px;
    border-radius: 6px;
    background: root.primary ? (pointer.pressed ? #365442 : @linear-gradient(180deg, #52745e, #456452)) : (root.dark ? @linear-gradient(180deg, pointer.has-hover ? #6d6d6d : #626262, #565656) : @linear-gradient(180deg, #ffffff, pointer.has-hover ? #eeeeec : #f5f5f3));
    border-width: keys.has-focus ? 2px : 1px;
    border-color: keys.has-focus ? #0a84ff : (root.primary ? #567761 : (root.dark ? #535353 : #d1d1cd));
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    label := Text { font-family: "Helvetica Neue"; text: root.text; font-size: 13px; font-weight: root.primary ? 600 : 400; color: root.primary ? white : (root.dark ? #eeeeee : #292929); horizontal-alignment: center; vertical-alignment: center; }
    pointer := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.clicked(); } }
}
// A quiet checkbox keeps the chooser consistent with the studio accent rather
// than inheriting the platform widget theme's unrelated highlight color.
component StarterOption inherits Rectangle {
    in property <bool> dark;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();
    height: 24px;
    accessible-role: checkbox;
    accessible-label: "Include a starting outline";
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " { root.toggled(); return accept; }
            return reject;
        }
    }
    HorizontalLayout { spacing: 9px;
        Rectangle {
            width: 16px; height: 16px; border-radius: 3px;
            border-width: keys.has-focus ? 2px : 1px;
            border-color: keys.has-focus ? #0a84ff : (root.checked ? #567761 : (root.dark ? #777777 : #b8b8b4));
            background: root.checked ? #456452 : (root.dark ? #343434 : white);
            Text { font-family: "Helvetica Neue"; text: root.checked ? "✓" : ""; font-size: 12px; font-weight: 600; color: white; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { font-family: "Helvetica Neue"; text: "Include a starting outline"; font-size: 13px; color: root.dark ? #eeeeee : #292929; vertical-alignment: center; }
        Rectangle { background: transparent; horizontal-stretch: 1; }
    }
    TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.toggled(); } }
}
component WritingCard inherits Rectangle {
    in property <string> title;
    in property <string> summary;
    in property <int> index;
    in property <int> columns: 4;
    callback navigated(int);
    in property <image> icon;
    in property <bool> selected;
    in property <bool> dark;
    in property <bool> enabled: true;
    callback picked();
    callback accepted();
    public function focus-card() { keys.focus(); }
    property <color> accent: root.dark ? #a6c9b0 : #456452;
    height: 96px;
    border-radius: 10px;
    background: root.selected ? (root.dark ? #3a3d39 : #edf2ee) : (root.dark ? (pointer.has-hover ? #292929 : #1f1f1f) : (pointer.has-hover ? #fafaf8 : #ffffff));
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? root.accent : (root.dark ? #454545 : #dededb);
    // Keep selection sage, with a separate inset keyboard-focus indicator.
    Rectangle {
        x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
        border-radius: 7px; background: transparent;
        border-width: keys.has-focus ? 1px : 0px;
        border-color: root.dark ? #a6c9b077 : #45645277;
    }
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.summary;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { keys.focus(); root.picked(); } }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            // Grid movement follows the visible column count, without wrapping
            // across row edges or accepting document/application shortcuts.
            if event.modifiers.control || event.modifiers.meta || event.modifiers.alt { return reject; }
            if event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Home || event.text == Key.End {
                let step = event.text == Key.LeftArrow ? (Math.mod(root.index, root.columns) > 0 ? -1 : 0) : (event.text == Key.RightArrow ? (Math.mod(root.index, root.columns) < root.columns - 1 ? 1 : 0) : (event.text == Key.UpArrow ? (root.index >= root.columns ? -root.columns : 0) : (root.index + root.columns <= 7 ? root.columns : 0)));
                let target = event.text == Key.Home ? 0 : (event.text == Key.End ? 7 : clamp(root.index + step, 0, 7));
                root.navigated(target);
                return accept;
            }
            if event.text == " " { root.picked(); return accept; }
            if event.text == Key.Return { root.picked(); root.accepted(); return accept; }
            return reject;
        }
    }
    HorizontalLayout { padding: 18px; spacing: 14px;
        VerticalLayout { horizontal-stretch: 0; width: 32px; Image { source: root.icon; width: 32px; height: 30px; image-fit: contain; colorize: root.selected ? root.accent : (root.dark ? #aaa9a5 : #73736f); } Rectangle { background: transparent; vertical-stretch: 1; } }
        VerticalLayout { horizontal-stretch: 1; spacing: 7px;
            Text { font-family: "Helvetica Neue"; text: root.title; font-size: 16px; font-weight: 600; wrap: word-wrap; color: root.dark ? #eeeeee : #292929; }
            Text { font-family: "Helvetica Neue"; text: root.summary; font-size: 12px; wrap: word-wrap; color: root.dark ? #aaa9a5 : #6b6b68; }
            Rectangle { background: transparent; vertical-stretch: 1; }
        }
        VerticalLayout { horizontal-stretch: 0; width: 15px; Rectangle { width: 15px; height: 15px; border-radius: 8px; border-width: 1px; border-color: root.selected ? root.accent : (root.dark ? #696969 : #bcbcb8); background: root.selected ? root.accent : transparent;
            Text { font-family: "Helvetica Neue"; text: root.selected ? "✓" : ""; font-size: 10px; font-weight: 700; color: root.dark ? #26302a : white; horizontal-alignment: center; vertical-alignment: center; }
        } Rectangle { background: transparent; vertical-stretch: 1; } }
    }
    pointer := TouchArea { enabled: root.enabled; clicked => { keys.focus(); root.picked(); } }
}
export component NewDocumentChooser inherits Rectangle {
    in property <bool> dark;
    in property <bool> enabled: true;
    in property <bool> show-open-actions: true;
    in-out property <int> layout-choice: 0;
    in-out property <int> academic-style: 0;
    in-out property <bool> include-starter: false;
    in-out property <int> choice: 0;
    callback create(int);
    callback cancel();
    callback open-project();
    callback open-source();
    property <bool> wide: root.width >= 1050px;
    property <length> card-width: (view.visible-width - (root.wide ? 36px : 12px)) / (root.wide ? 4 : 2);
    property <color> ink: root.dark ? #eeeeee : #292929;
    property <color> secondary: root.dark ? #aaa9a5 : #6b6b68;
    function select-category(index: int) {
        if root.choice != index { root.layout-choice = 0; }
        root.choice = index;
    }
    public function focus-choice(index: int) {
        root.select-category(index);
        if index == 0 { screenplay.focus-card(); }
        if index == 1 { comic.focus-card(); }
        if index == 2 { book.focus-card(); }
        if index == 3 { academic.focus-card(); }
        if index == 4 { stage.focus-card(); }
        if index == 5 { audio.focus-card(); }
        if index == 6 { general.focus-card(); }
        if index == 7 { poetry.focus-card(); }
        let top = cards.y + Math.floor(index / (root.wide ? 4 : 2)) * 108px;
        if top + view.content-y < 0px { view.content-y = -top; }
        else if top + 96px + view.content-y > view.visible-height { view.content-y = min(0px, view.visible-height - top - 96px); }
    }
    public function reset() { root.choice = 0; root.layout-choice = 0; root.include-starter = false; root.academic-style = 0; screenplay.focus-card(); view.content-y = 0px; }
    changed width => { if root.enabled { view.content-y = 0px; } }
    background: root.dark ? #323232 : #f4f4f2;
    FocusScope {
        enabled: root.enabled;
        capture-key-pressed(event) => { if event.text == Key.Escape { root.cancel(); return accept; } return reject; }
        content := VerticalLayout {
            width: min(parent.width - 80px, root.wide ? 1080px : 640px);
            // Size from the actual body, including wrapped academic guidance.
            // An estimated height caused a scrollbar even in roomy windows.
            height: min(parent.height - 64px, body.preferred-height + 67px + (root.show-open-actions ? 44px : 0px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            spacing: 18px;
            view := ScrollView {
                vertical-stretch: 1; min-height: 64px;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: body.preferred-height;
                body := VerticalLayout { width: view.visible-width; spacing: 22px; alignment: start;
                    VerticalLayout { spacing: 10px; height: 66px; padding-bottom: 8px;
                        Text { text: "Fountage"; font-family: "Georgia"; font-size: 30px; color: root.ink; horizontal-alignment: center; }
                        Text { font-family: "Helvetica Neue"; text: "by Baz Studios"; font-size: 12px; color: root.secondary; horizontal-alignment: center; }
                    }
                    VerticalLayout { spacing: 8px;
                        Text { text: "What will you write?"; font-family: "Georgia"; font-size: 28px; color: root.ink; }
                        Text { font-family: "Helvetica Neue"; text: "Choose a document type to set up your workspace."; font-size: 13px; color: root.secondary; wrap: word-wrap; }
                    }
                    cards := GridLayout { spacing: 12px; height: root.wide ? 204px : 420px;
                        screenplay := WritingCard { width: root.card-width; index: 0; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: 0; col: 0; title: "Screenplay"; summary: "Scenes, action and dialogue."; icon: @image-url("icons/film.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 0; picked => { root.select-category(0); } accepted => { root.create(0); } }
                        comic := WritingCard { width: root.card-width; index: 1; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: 0; col: 1; title: "Comic Script"; summary: "Comic books and graphic novels."; icon: @image-url("icons/comic.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 1; picked => { root.select-category(1); } accepted => { root.create(1); } }
                        book := WritingCard { width: root.card-width; index: 2; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 0 : 1; col: root.wide ? 2 : 0; title: "Book"; summary: "Novels, memoirs and nonfiction."; icon: @image-url("icons/book.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 2; picked => { root.select-category(2); } accepted => { root.create(2); } }
                        academic := WritingCard { width: root.card-width; index: 3; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 0 : 1; col: root.wide ? 3 : 1; title: "Academic Paper"; summary: "Sections and a saved style edition."; icon: @image-url("icons/academic.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 3; picked => { root.select-category(3); } accepted => { root.create(3); } }
                        stage := WritingCard { width: root.card-width; index: 4; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 1 : 2; col: 0; title: "Stage Play"; summary: "Acts, scenes and stage directions."; icon: @image-url("icons/stage.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 4; picked => { root.select-category(4); } accepted => { root.create(4); } }
                        audio := WritingCard { width: root.card-width; index: 5; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 1 : 2; col: 1; title: "Audio Script"; summary: "Audio dramas and podcasts."; icon: @image-url("icons/audio.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 5; picked => { root.select-category(5); } accepted => { root.create(5); } }
                        general := WritingCard { width: root.card-width; index: 6; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 1 : 3; col: root.wide ? 2 : 0; title: "General Writing"; summary: "Articles, notes and fresh ideas."; icon: @image-url("icons/pencil.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 6; picked => { root.select-category(6); } accepted => { root.create(6); } }
                        poetry := WritingCard { width: root.card-width; index: 7; columns: root.wide ? 4 : 2; navigated(value) => { root.focus-choice(value); } row: root.wide ? 1 : 3; col: root.wide ? 3 : 1; title: "Poetry & Lyrics"; summary: "Stanzas, verses and choruses."; icon: @image-url("icons/poetry.svg"); dark: root.dark; enabled: root.enabled; selected: root.choice == 7; picked => { root.select-category(7); } accepted => { root.create(7); } }
                    }

                    VerticalLayout { spacing: 12px;
                    HorizontalLayout { spacing: 12px;
                        Text { font-family: "Helvetica Neue"; text: "Layout"; width: 105px; font-size: 13px; color: root.ink; vertical-alignment: center; }
                        ComboBox {
                            width: 270px; height: 26px;
                            enabled: root.enabled;
                            accessible-label: "Layout";
                            model: root.choice == 0 ? ["Screenplay"] : root.choice == 1 ? ["Fountage Standard", "Lettering Friendly"] : root.choice == 2 ? ["Manuscript", "Reading Draft"] : root.choice == 3 ? ["Academic Draft"] : root.choice == 4 ? ["Stage Draft"] : root.choice == 5 ? ["Audio Drama", "Podcast"] : root.choice == 6 ? ["Free Writing", "Outline"] : ["Poetry", "Song Lyrics"];
                            current-index <=> root.layout-choice;
                        }
                        Rectangle { background: transparent; horizontal-stretch: 1; }
                    }
                    if root.choice == 3: VerticalLayout { spacing: 8px;
                        HorizontalLayout { spacing: 12px;
                            Text { font-family: "Helvetica Neue"; text: "Required style"; width: 105px; color: root.ink; font-size: 13px; vertical-alignment: center; }
                            ComboBox { enabled: root.enabled; accessible-label: "Required academic style"; model: ["Not selected", "APA 7 · Student", "APA 7 · Professional", "MLA 9"]; current-index <=> root.academic-style; }
                            Rectangle { background: transparent; horizontal-stretch: 1; }
                        }
                        Text { font-family: "Helvetica Neue"; text: "The edition is saved with your paper. Citation and page formatting are not yet applied."; font-size: 12px; color: root.secondary; wrap: word-wrap; }
                    }
                    StarterOption { dark: root.dark; enabled: root.enabled; checked <=> root.include-starter; toggled => { root.include-starter = !root.include-starter; } }
                    }
                }
            }
                    Rectangle { height: 1px; background: root.dark ? #454545 : #d5d5d1; }
                    HorizontalLayout { spacing: 10px;
                        Text { font-family: "Helvetica Neue"; text: "You can change the layout as you write."; font-size: 12px; color: root.secondary; vertical-alignment: center; wrap: word-wrap; }
                        Rectangle { background: transparent; horizontal-stretch: 1; }
                        ChooserButton { dark: root.dark; enabled: root.enabled; text: "Cancel"; clicked => { root.cancel(); } }
                        ChooserButton { dark: root.dark; enabled: root.enabled; text: "Create"; primary: true; clicked => { root.create(root.choice); } }
                    }
                    if root.show-open-actions: HorizontalLayout { spacing: 10px; height: 26px;
                        ChooserButton { dark: root.dark; enabled: root.enabled; text: "Open Project…"; clicked => { root.open-project(); } }
                        ChooserButton { dark: root.dark; enabled: root.enabled; text: "Open Source…"; clicked => { root.open-source(); } }
                        Rectangle { background: transparent; horizontal-stretch: 1; }
                    }
        }
    }
}
