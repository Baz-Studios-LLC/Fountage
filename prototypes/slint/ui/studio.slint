    out property <float> formatted-surface-x: editor.surface-x;
    out property <float> formatted-surface-y: editor.surface-y;
    in property <bool> formatted-ime-active: false;
    changed formatted-has-focus => { root.formatted-focus-changed(); }
    changed formatted-surface-x => { root.formatted-focus-changed(); }
    changed formatted-surface-y => { root.formatted-focus-changed(); }
    in property <int> formatted-shaped-paragraphs;
    in property <int> formatted-reused-paragraphs;
    in property <string> formatted-status;
    out property <string> formatted-caption: root.formatted-status != "" ? root.formatted-status : "Experimental formatted editor · " + (root.formatted-composing ? "Composing text · draft unchanged" : (root.dirty ? "Unsaved edits" : "No unsaved text changes")) + " · IME/accessibility pending";
    callback formatted-refresh(float, float);
    callback formatted-point(float, float, bool);
    callback formatted-scroll(float);
    callback formatted-key(KeyEvent) -> bool;
    callback formatted-navigation(string, bool);
    callback formatted-delete-word(bool);
    callback formatted-select(int, int);
    callback formatted-restore-selection(int, int, bool, bool);
    in property <bool> formatted-focus-upstream: false;
    in property <bool> formatted-anchor-upstream: false;
    callback formatted-all();
    in property <bool> formatted-has-selection;
    callback formatted-selection() -> string;
    callback formatted-insert(string);
    public function mirror-formatted-selection(anchor: int, focus: int) { editor.mirror-selection(anchor, focus); }
    changed category => { root.preview-selection-valid = false; if root.category != 0 { root.formatted-active = false; if root.navigation-mode == 2 { root.navigation-mode = 0; } } }
    in property <bool> dirty: false;
    preferred-width: 1280px; preferred-height: 860px;
    min-width: 960px; min-height: 640px;

    in-out property <string> source;
    in-out property <bool> dark: false;
    in-out property <bool> white-paper: true;
    callback appearance-changed();
    callback format-source(int);
    callback note-source();
    callback insert-tasks();
    callback task-newline() -> bool;
    out property <bool> can-edit-source: !root.preview-open && !root.confirm-close && !root.file-dialog-open && editor.has-focus && !editor.composing && !root.formatted-composing;
    out property <bool> can-format-source: root.category == 0 && root.can-edit-source;

    in-out property <int> category: 0;
    in property <string> summary;
    in property <string> word-count: "0";
    in property <[string]> cast;
    in-out property <bool> preview-open: false;
    property <string> preview-source;
    property <bool> preview-selection-valid;
    property <int> preview-anchor;
    property <int> preview-focus;
    property <bool> preview-anchor-upstream;
    property <bool> preview-focus-upstream;
    out property <bool> can-toggle-preview: !root.confirm-close && !root.file-dialog-open && !root.new-draft-open && !editor.composing && !root.formatted-composing;
    public function toggle-preview() {
        if !root.can-toggle-preview { return; }
        root.history-boundary();
        if !root.preview-open {
            // Capture before hiding the editor: TextInput focus-out collapses
            // its anchor. Keep formatted wrap affinity as well as byte offsets.
            root.preview-selection-valid = true;
            root.preview-source = root.source;
            root.preview-anchor = editor.selection-anchor;
            root.preview-focus = editor.selection-focus;
            root.preview-anchor-upstream = root.formatted-anchor-upstream;
            root.preview-focus-upstream = root.formatted-focus-upstream;
            root.preview-open = true;
        } else {
            root.preview-open = false;
            if root.formatted-active { root.formatted-refresh(editor.width / 1px, editor.height / 1px); }
            editor.focus-editor();
            // Opening/recovering/replacing a document invalidates old offsets.
            if root.preview-selection-valid && root.source == root.preview-source {
                editor.set-visual-selection(root.preview-anchor, root.preview-focus, root.preview-anchor-upstream, root.preview-focus-upstream);
            } else {
                editor.set-selection-offsets(0, 0);
            }
        }
    }

    in-out property <bool> focus-mode: false;
    public function toggle-focus() {
        if !root.confirm-close && !root.file-dialog-open && !root.new-draft-open {
            root.formatted-finish();
            root.history-boundary();
            root.field-sync();
            root.field-boundary();
            root.focus-mode = !root.focus-mode;
            if root.preview-open { focus-toggle.focus(); }
            else { editor.focus-editor(); }
        }
    }
    in property <[OutlineRow]> location-rows;
    in property <[StandardListViewItem]> location-labels;
    in property <string> location-status;
    in property <[OutlineRow]> outline-rows;
    in property <[StandardListViewItem]> outline-labels;
