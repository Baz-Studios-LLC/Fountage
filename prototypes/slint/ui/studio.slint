import { Button, LineEdit, CheckBox, ComboBox, ScrollView, AboutSlint, Palette, StandardListView } from "std-widgets.slint";
import { ManuscriptEditor } from "manuscript-editor.slint";
import { TitlePageDialog } from "title-page-dialog.slint";
import { ShelfPanel, ShelfRow } from "shelf-panel.slint";
import { NewDocumentChooser } from "new-document-chooser.slint";
export struct PreviewLine { text: string, styled: styled-text, indent: length }
export struct OutlineRow { text: string, body: string, start-byte: int, end-byte: int }
export component Studio inherits Window {
    // macOS keeps its real window buttons above this full-size content view.
    // Other platforms retain their regular system title bar.
    in property <bool> integrated-titlebar: false;
    callback drag-window();
    in property <string> document-name: "Scratch draft";
    // Derived presentation only; file identity and Save Copy names stay independent.
    changed document-name => { root.preview-selection-valid = false; }
    in property <string> manuscript-title;
    property <string> category-label: ["SCREENPLAY", "COMIC", "NOVEL", "ACADEMIC", "STAGEPLAY", "AUDIO", "GENERAL", "POETRY"][root.category];
    title: root.document-name + " — Fountage · Slint Lab · v001" + (root.dirty ? " · Edited" : "");
    in-out property <bool> formatted-active: false;
    public function toggle-formatted-editor() {
        if root.category != 0 || root.confirm-close || root.file-dialog-open || editor.composing { return; }
        if root.preview-open { root.toggle-preview(); }
        root.formatted-finish(); root.history-boundary();
        // Snapshot before hiding TextInput: focus-out can collapse its anchor.
        let anchor = editor.selection-anchor;
        let focus = editor.selection-focus;
        root.preview-open = false;
        root.formatted-active = !root.formatted-active;
        if root.formatted-active { root.formatted-refresh(editor.width / 1px, editor.height / 1px); }
        editor.focus-editor();
        editor.set-selection-offsets(anchor, focus);
    }

    in property <image> formatted-frame;
    in property <bool> formatted-ready: false;
    in property <bool> formatted-composing: false;
    callback formatted-preedit(string, int, int);
    callback formatted-commit(string);
    callback formatted-cancel();
    callback formatted-finish();
    callback formatted-focus-changed();
