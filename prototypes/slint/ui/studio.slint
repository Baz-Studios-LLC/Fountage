    in-out property <bool> task-removal-open: false;
    in property <string> task-removal-label;
    changed task-removal-open => { if root.task-removal-open { cancel-task-removal.focus(); } }
    out property <bool> can-toggle-task: root.navigation-mode == 3 && root.outline-selected >= 0 && root.source == root.outline-source && root.category == root.outline-category && !root.preview-open && root.can-toggle-preview;
    in property <string> note-filter-status;
    callback note-filter-changed();
    changed note-query => { root.field-sync(); root.note-filter-changed(); }
    in-out property <int> navigation-mode: 0;
    private property <bool> outline-tab-selected: true;
    private property <bool> notes-tab-selected: false;
    private property <bool> locations-tab-selected: false;
    private property <bool> tasks-tab-selected: false;
    function sync-navigation-tabs() {
        root.outline-tab-selected = root.navigation-mode == 0;
        root.notes-tab-selected = root.navigation-mode == 1;
        root.locations-tab-selected = root.navigation-mode == 2;
        root.tasks-tab-selected = root.navigation-mode == 3;
    }
    function choose-navigation(mode: int) { root.navigation-mode = mode; root.sync-navigation-tabs(); }
    changed navigation-mode => { root.outline-selected = -1; root.sync-navigation-tabs(); }
    in-out property <int> outline-selected: -1;
    in property <string> outline-source;
    in property <int> outline-category;
    callback navigate(int);
    callback browse-navigation(int);
    out property <bool> navigator-has-focus: navigator.has-focus;
    public function focus-navigation() {
        if !root.confirm-close && !root.file-dialog-open && !root.focus-mode { root.formatted-finish(); root.history-boundary(); root.field-sync(); navigator.focus(); }
    }
    public function browse-source(anchor: int, focus: int) {
        if !root.confirm-close && !root.file-dialog-open {
            root.preview-open = false;
            root.history-boundary();
            editor.set-selection-offsets(anchor, focus);
        }
    }
    in-out property <bool> find-open: false;
    in-out property <string> find-query;
    in-out property <bool> find-match-case: false;
    in-out property <int> find-mode: 0;
    in-out property <bool> find-wrap: true;
    in-out property <bool> find-regex: false;
    in-out property <string> find-status: "Enter text to search";
    in-out property <bool> replace-open: false;
    in-out property <string> replacement;
    in property <bool> find-can-replace: false;
    callback replace-match(bool);
    callback replace-and-find();
    callback find-step(bool);
    callback find-invalidated();
    public function show-find() {
        if !root.confirm-close && !root.file-dialog-open {
            root.formatted-finish();
            root.history-boundary();
            root.field-sync();
            root.field-boundary();
            root.preview-open = false;
            root.find-open = true;
            find-input.focus();
        }
    }
    changed find-query => { root.field-sync(); root.find-invalidated(); }
    changed find-match-case => { root.find-invalidated(); }
    changed find-mode => { root.find-invalidated(); }
    changed find-wrap => { root.find-invalidated(); }
    changed find-regex => { root.find-invalidated(); }
    changed source => {
        if root.preview-open { root.preview-selection-valid = false; }
        if root.find-open { root.find-invalidated(); }
    }

    in property <string> status: "Scratch document · Save a copy to keep your draft";
    in property <[PreviewLine]> lines;
    in property <string> preview-error;
    in property <string> analysis-status: "Preparing preview…";
    public function focus-source() {
        if !root.confirm-close && !root.file-dialog-open {
            if root.preview-open { root.toggle-preview(); }
            else { editor.focus-editor(); }
        }
    }
    public function select-source(anchor: int, focus: int) {
        if !root.confirm-close && !root.file-dialog-open {
            root.preview-open = false;
            root.history-boundary();
            editor.focus-editor();
            editor.set-selection-offsets(anchor, focus);
        }
    }
    public function restore-source-selection(anchor: int, focus: int, anchor-upstream: bool, focus-upstream: bool) {
        if !root.confirm-close && !root.file-dialog-open {
            root.preview-open = false; root.history-boundary(); editor.focus-editor();
            editor.set-visual-selection(anchor, focus, anchor-upstream, focus-upstream);
        }
    }
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> query-can-undo: false;
    in property <bool> query-can-redo: false;
    in property <bool> replacement-can-undo: false;
    in property <bool> replacement-can-redo: false;
    in property <bool> note-query-can-undo: false;
    in property <bool> note-query-can-redo: false;
    out property <int> history-context: root.navigation-mode == 1 && note-input.has-focus ? 3 : (root.find-open && find-input.has-focus ? 1 : (root.find-open && root.replace-open && replace-input.has-focus ? 2 : 0));
    property <bool> focused-can-undo: root.shelf-open ? (root.shelf-query-focused ? root.shelf-query-can-undo : root.shelf-can-undo) : root.title-page-input-focused ? root.title-can-undo : (root.history-context == 3 ? root.note-query-can-undo : (root.history-context == 1 ? root.query-can-undo : (root.history-context == 2 ? root.replacement-can-undo : root.can-undo)));
    property <bool> focused-can-redo: root.shelf-open ? (root.shelf-query-focused ? root.shelf-query-can-redo : root.shelf-can-redo) : root.title-page-input-focused ? root.title-can-redo : (root.history-context == 3 ? root.note-query-can-redo : (root.history-context == 1 ? root.query-can-redo : (root.history-context == 2 ? root.replacement-can-redo : root.can-redo)));
    callback field-edited(int, string);
    callback field-input(int, string);
    callback field-sync();
    callback field-boundary();
    callback field-history-action(int, bool);
    public function select-field(kind: int, anchor: int, focus: int) {
        if !root.confirm-close && !root.file-dialog-open {
            if kind == 1 { find-input.focus(); find-input.set-selection-offsets(anchor, focus); }
            if kind == 2 { replace-input.focus(); replace-input.set-selection-offsets(anchor, focus); }
            if kind == 3 { note-input.focus(); note-input.set-selection-offsets(anchor, focus); }
        }
    }
    changed replacement => { root.field-sync(); }
    property <bool> input-focused: editor.has-focus || (root.navigation-mode == 1 && note-input.has-focus) || (root.find-open && find-input.has-focus) || (root.find-open && root.replace-open && replace-input.has-focus);
    public function perform-history(redo: bool) {
        if root.shelf-open { root.shelf-history(redo); return; }
        if root.title-page-input-focused && !root.confirm-close { if root.title-page-composing { root.title-page-error = "Finish composing text before applying or editing the field history."; } else { root.title-field-history(redo); } return; }
        if !root.confirm-close && !root.file-dialog-open && (redo ? root.focused-can-redo : root.focused-can-undo) {
            if root.history-context == 0 { root.history-action(redo); }
            else { root.field-history-action(root.history-context, redo); }
        }
    }
    public function clipboard-action(action: int) {
        if root.shelf-quick-focused && !root.confirm-close { shelf-panel.quick-clipboard(action); return; }
        if root.shelf-query-focused && !root.confirm-close { shelf-panel.query-clipboard(action); return; }
        if root.shelf-draft-input-focused && !root.confirm-close { shelf-panel.draft-clipboard(action); return; }
        if root.title-page-input-focused && !root.confirm-close { title-dialog.clipboard(action); return; }
        if !root.confirm-close && !root.file-dialog-open {
            root.history-boundary();
            root.field-sync();
            root.field-boundary();
            if root.navigation-mode == 1 && note-input.has-focus {
                if action == 0 { note-input.cut(); }
                else if action == 1 { note-input.copy(); }
                else if action == 2 { note-input.paste(); }
                else if action == 3 { note-input.select-all(); }
            } else if root.find-open && find-input.has-focus {
                if action == 0 { find-input.cut(); }
                else if action == 1 { find-input.copy(); }
                else if action == 2 { find-input.paste(); }
                else if action == 3 { find-input.select-all(); }
            } else if root.find-open && root.replace-open && replace-input.has-focus {
                if action == 0 { replace-input.cut(); }
                else if action == 1 { replace-input.copy(); }
                else if action == 2 { replace-input.paste(); }
                else if action == 3 { replace-input.select-all(); }
            } else if editor.has-focus {
                if action == 0 { editor.cut(); }
                else if action == 1 { editor.copy(); }
                else if action == 2 { editor.paste(); }
                else if action == 3 { editor.select-all(); }
            }
            root.history-boundary();
            root.field-boundary();
        }
    }
    public function show-replace() {
        if !root.confirm-close && !root.file-dialog-open {
            root.show-find();
            root.replace-open = true;
            replace-input.focus();
        }
    }
